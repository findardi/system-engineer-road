/* scroll down or terminfo indn */[m
static void CSI_SD( Framebuffer* fb, Dispatcher* dispatch )[m
{[m
  fb->scroll( dispatch->getparam( 0, 1 ) );[m
}[m
[m
static Function func_CSI_SD( CSI, "S", CSI_SD );[m
[m
/* scroll up or terminfo rin */[m
static void CSI_SU( Framebuffer* fb, Dispatcher* dispatch )[m
{[m
  fb->scroll( -dispatch->getparam( 0, 1 ) );[m
}[m
[m
static Function func_CSI_SU( CSI, "T", CSI_SU );[m
