:[K[K/* Terminal functions -- routines activated by CSI, escape or a control char */[m
[m
static void clearline( Framebuffer* fb, int row, int start, int end )[m
{[m
  for ( int col = start; col <= end; col++ ) {[m
    fb->reset_cell( fb->get_mutable_cell( row, col ) );[m
  }[m
}[m
[m
/* erase in line */[m
static void CSI_EL( Framebuffer* fb, Dispatcher* dispatch )[m
{[m
  switch ( dispatch->getparam( 0, 0 ) ) {[m
    case 0: /* default: active position to end of line, inclusive */[m
      clearline( fb, -1, fb->ds.get_cursor_col(), fb->ds.get_width() - 1 );[m
      break;[m
    case 1: /* start of screen to active position, inclusive */[m
      clearline( fb, -1, 0, fb->ds.get_cursor_col() );[m
      break;[m
    case 2: /* all of line */[m
      fb->reset_row( fb->get_mutable_row( -1 ) );[m
      break;[m
    default:[m
:[K[K[HM[m
